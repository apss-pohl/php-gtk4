# gen/gir.php's pre-existing findings (untyped array shapes in the emitters) are baselined so new
# code in it is analysed at level max; regenerate the baseline after reducing it:
#   vendor/bin/phpstan analyse --generate-baseline=phpstan-baseline-gir.neon gen/gir.php
includes:
    - phpstan-baseline-gir.neon

# PHPStan - max level over the PHP side of the project. The Gtk4\ classes come
# from stubs/gtk4.php (scanFiles), so this runs without the extension loaded.
parameters:
    level: max
    phpVersion: 80400
    # src/gtk4.stub.php is php-src stub syntax (empty bodies, UNKNOWN) - not analysable;
    # the derived stubs/gtk4.php is scanned for the Gtk4\ symbols instead.
    excludePaths:
        - tests/phpt
    paths:
        - tests
        - examples
        - gen/ide-stub.php
        - gen/method-comments.php
        - gen/map-status.php
        - gen/gir.php
        - gen/gir
    scanFiles:
        - stubs/gtk4.php
    tmpDir: .phpstan.cache
    # PHPStan 2 auto-detects the core count; this only raises the default cap.
    parallel:
        maximumNumberOfProcesses: 64
    ignoreErrors:
        # Stub bodies are placeholders, so a documented @throws is never "used".
        -
            path: stubs/gtk4.php
            identifier: throws.unusedType
