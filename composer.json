{
    "name": "php-gtk4/php-gtk4",
    "description": "Test/dev tooling for the php-gtk4 extension (the extension itself is built with make)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "overtrue/phplint": "^9",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload-dev": {
        "psr-4": { "PhpGtk4\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.4.0" },
        "sort-packages": true
    }
}
