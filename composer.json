{
    "name": "php-gtk4/php-gtk4",
    "description": "GTK 4 bindings for PHP: desktop applications written in PHP against the native GTK 4 API. Installed with PIE (pie install php-gtk4/php-gtk4); the IDE/PHPStan stubs are the separate php-gtk4/stubs package.",
    "type": "php-ext",
    "keywords": [
        "gtk",
        "gtk4",
        "gui",
        "desktop",
        "extension",
        "php-gtk4"
    ],
    "homepage": "https://github.com/apss-pohl/php-gtk4",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/apss-pohl/php-gtk4/issues",
        "source": "https://github.com/apss-pohl/php-gtk4"
    },
    "require": {
        "php": ">=8.4"
    },
    "php-ext": {
        "extension-name": "gtk4",
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "windows"
        ],
        "configure-options": [
            {
                "name": "enable-gtk4-webkit",
                "description": "Bind WebKitGTK 6 and JavaScriptCore (WebKit*/JSC* classes). Needs libwebkitgtk-6.0-dev; Linux only.",
                "needs-value": false
            }
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "nikic/php-parser": "^5.8",
        "overtrue/phplint": "^9",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "qa": "./ci.sh --only=php-qa",
        "test": "./tests/run.sh",
        "ci": "./ci.sh"
    },
    "autoload-dev": {
        "psr-4": {
            "PhpGtk4\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    }
}
