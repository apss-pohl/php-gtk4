# run-tests.php per-test artefacts (tests/phpt): for every x.phpt it writes x.php, x.sh, ...
# Hence *every* .php here is ignored - hand-written helpers use .inc (skipif-display.inc).
/tests/phpt/*.diff
/tests/phpt/*.exp
/tests/phpt/*.log
/tests/phpt/*.out
/tests/phpt/*.php
/tests/phpt/*.sh

