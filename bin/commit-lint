#!/usr/bin/env bash
#
# Conventional Commits gate. One implementation, three callers:
#
#   bin/commit-lint --message .git/COMMIT_EDITMSG   .githooks/commit-msg (one message file)
#   bin/commit-lint --text "feat: css"             a bare subject - CI checks the PR title,
#                                                  because a squash merge makes it the commit
#   bin/commit-lint [--range <range>]              every commit in a range; ./ci.sh --only=commits
#                                                  (default: the commits this branch adds to main)
#
# The format (https://www.conventionalcommits.org):
#
#   <type>[(scope)][!]: <subject>
#   <blank line>
#   <body>
#
# Enforced: a known type, an optional lower-case scope, `!` for a breaking change, a
# non-empty subject without a trailing period, a header of at most 100 characters, and a
# blank line before the body. Capitalisation of the subject is *not* enforced - subjects
# here start with identifiers (`fix: GdkTexture keeps ...`).
#
# The messages are the release notes: bin/release-notes groups them by type, so a wrong
# type is a wrong section in the next release body.
set -euo pipefail

TYPES=(build chore ci docs feat fix perf refactor revert style test)
MAX_HEADER=100

RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; DIM=$'\033[2m'; NC=$'\033[0m'
[[ -t 1 ]] || { RED=''; GREEN=''; DIM=''; NC=''; }

types_re=$(IFS='|'; echo "${TYPES[*]}")
HEADER_RE="^(${types_re})(\([a-z0-9][a-z0-9._/-]*\))?!?: .+"

failed=0

# Print why one header was rejected, with the cheat sheet, and remember the failure.
reject() {
    local subject=$1 reason=$2 where=${3:-}
    printf '%scommit-lint%s: %s\n' "$RED" "$NC" "$reason" >&2
    [[ -n $where ]] && printf '  %s%s%s\n' "$DIM" "$where" "$NC" >&2
    printf '  %s\n\n' "$subject" >&2
    failed=1
}

# The cheat sheet, printed once after the last rejection.
usage_hint() {
    cat >&2 <<EOF
  Expected:  <type>[(scope)][!]: <subject>
  Types:     ${TYPES[*]}
  Examples:  feat(css): GtkCssProvider and the display it attaches to
             fix: GdkTexture keeps a private constructor
             refactor(core)!: wrap() returns the nearest registered class
  Rules:     header <= $MAX_HEADER chars, no trailing period, blank line before the body.
  Details:   docs/CONTRIBUTING.md "Commit messages"
EOF
}

# Validate one whole message (subject plus body). $2 identifies it in the output.
check_message() {
    local message=$1 where=${2:-}
    # Strip the comment lines git appends to the editor buffer.
    message=$(printf '%s\n' "$message" | sed '/^#/d')
    local subject second
    subject=$(printf '%s\n' "$message" | sed -n '1p')
    second=$(printf '%s\n' "$message" | sed -n '2p')

    if [[ -n "$second" ]]; then
        reject "$subject" 'the line after the subject must be blank (git needs it to split subject from body)' "$where"
        return
    fi
    check_header "$subject" "$where"
}

# Validate a single header line (a subject, or a PR title).
check_header() {
    local subject=$1 where=${2:-}
    case $subject in
        'Merge branch '*|'Merge pull request '*|'Merge remote-tracking '*|'Revert "'*)
            return ;;  # generated by git and GitHub; not ours to format
        'fixup! '*|'squash! '*|'amend! '*)
            # Fine while they are local (the hook lets them through); they must never
            # reach a branch that gets reviewed.
            if [[ $MODE == range ]]; then
                reject "$subject" 'autosquash commit - rebase it away before pushing (git rebase -i --autosquash)' "$where"
            fi
            return ;;
    esac

    if [[ ${#subject} -gt $MAX_HEADER ]]; then
        reject "$subject" "header is ${#subject} characters, the limit is $MAX_HEADER" "$where"
        return
    fi
    if [[ ! $subject =~ $HEADER_RE ]]; then
        reject "$subject" 'not a Conventional Commit' "$where"
        return
    fi
    if [[ $subject == *. ]]; then
        reject "$subject" 'the subject must not end in a period' "$where"
        return
    fi
}

# What to check when no range was given, in order of preference:
#
#   $COMMIT_LINT_RANGE            an explicit override (CI passes the PR's base..HEAD)
#   @{upstream}..HEAD             what this branch is about to push - the pre-push gate, and
#                                 the only commits still cheap to reword
#   <merge-base with main>..HEAD  a branch with no upstream yet: everything it adds
#
# Nothing (an empty range) is a pass: a branch level with its upstream has nothing to say.
default_range() {
    local base head
    if [[ -n ${COMMIT_LINT_RANGE:-} ]]; then
        printf '%s\n' "$COMMIT_LINT_RANGE"
        return 0
    fi
    head=$(git rev-parse HEAD)
    if base=$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null); then
        [[ "$base" == "$head" ]] && return 0
        printf '%s..HEAD\n' "$base"
        return 0
    fi
    for ref in origin/main main origin/HEAD; do
        if base=$(git merge-base "$ref" HEAD 2>/dev/null); then
            [[ "$base" == "$head" ]] && return 0   # nothing of our own on top
            printf '%s..HEAD\n' "$base"
            return 0
        fi
    done
    printf 'HEAD~1..HEAD\n'   # no main to compare against (a fresh clone of one branch)
}

MODE=range
RANGE=""
case ${1:-} in
    --message)
        MODE=message
        [[ -f ${2:-} ]] || { echo "commit-lint: --message needs a readable file" >&2; exit 2; }
        check_message "$(cat "$2")"
        ;;
    --text)
        MODE=text
        [[ -n ${2:-} ]] || { echo "commit-lint: --text needs a subject" >&2; exit 2; }
        check_header "$2" 'PR title:'
        ;;
    --range|'')
        [[ ${1:-} == --range ]] && RANGE=${2:-}
        [[ -n $RANGE ]] || RANGE=$(default_range)
        if [[ -z $RANGE ]]; then
            printf '%scommit-lint%s: no commits of this branch to check\n' "$GREEN" "$NC"
            exit 0
        fi
        count=0
        while IFS= read -r sha; do
            [[ -n $sha ]] || continue
            count=$((count + 1))
            check_message "$(git log -1 --format='%B' "$sha")" "$(git log -1 --format='%h' "$sha")"
        done < <(git rev-list --no-merges --reverse "$RANGE" 2>/dev/null)
        [[ $failed -eq 0 ]] && printf '%scommit-lint%s: %d commit(s) in %s, all conventional\n' \
            "$GREEN" "$NC" "$count" "$RANGE"
        ;;
    -h|--help)
        sed -n '2,/^set -/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "commit-lint: unknown argument '$1' (--message FILE | --text SUBJECT | --range RANGE)" >&2
        exit 2
        ;;
esac

if [[ $failed -ne 0 ]]; then
    usage_hint
    exit 1
fi
[[ $MODE == range ]] || printf '%scommit-lint%s: ok\n' "$GREEN" "$NC"
