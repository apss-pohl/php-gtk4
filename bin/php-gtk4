#!/usr/bin/env bash
#
# Run a PHP script with the gtk4 extension and WITHOUT php-gtk3, even when
# gtk3 is enabled system-wide. Both extensions register the same class names,
# so they must never be loaded into one process.
#
#   bin/php-gtk4 script.php [args...]
#   PHP=php8.4 GTK4_SO=./gtk4.so bin/php-gtk4 script.php     # use a fresh build
#
# How: PHP_INI_SCAN_DIR replaces the conf.d directory with a temporary one
# containing every ini except gtk3's, then gtk4 is added with -dextension.
# All other extensions (mbstring, curl, ...) stay available - unlike `php -n`.
set -euo pipefail

PHP=${PHP:-php8.4}
# Prefer the freshly built extension in the repo (./gtk4.so next to bin/) over the
# installed one, so the launcher never silently runs a stale system copy.
# GTK4_SO=gtk4 forces the installed extension; a path forces that file.
REPO_SO="$(cd "$(dirname "$0")/.." && pwd)/gtk4.so"
if [[ -z "${GTK4_SO:-}" && -f "$REPO_SO" ]]; then GTK4_SO="$REPO_SO"; fi
GTK4_SO=${GTK4_SO:-gtk4}   # bare name -> from extension_dir; or a path to a .so

SCAN_DIR=$("$PHP" -n -r 'echo PHP_CONFIG_FILE_SCAN_DIR;')
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

if [[ -d "$SCAN_DIR" ]]; then
    for ini in "$SCAN_DIR"/*.ini; do
        [[ -e "$ini" ]] || continue
        # Skip any ini that loads gtk3 (installed as gtk.ini / gtk3.ini / 20-gtk.ini ...)
        if grep -qE '^\s*extension\s*=\s*"?(php_)?gtk3?(\.so)?"?\s*$' "$ini"; then continue; fi
        # Skip gtk4's own ini too; it is added explicitly below
        if grep -qE '^\s*extension\s*=\s*"?(php_)?gtk4(\.so)?"?\s*$' "$ini"; then continue; fi
        ln -s "$ini" "$TMP/$(basename "$ini")"
    done
fi

[[ "$GTK4_SO" == */* ]] && GTK4_SO=$(readlink -f "$GTK4_SO")

# PHP_GTK4_ENV: extra VAR=value pairs, one per line, applied to the php process only
# (used by ci.sh --only=asan for LD_PRELOAD=libasan etc. - must not leak into this
# script's own helper processes). Newline-separated so a value may contain spaces.
extra=()
if [[ -n "${PHP_GTK4_ENV:-}" ]]; then
    while IFS= read -r kv; do [[ -n "$kv" ]] && extra+=("$kv"); done <<< "$PHP_GTK4_ENV"
fi
PHP_INI_SCAN_DIR="$TMP" exec env "${extra[@]}" "$PHP" -dextension="$GTK4_SO" "$@"
