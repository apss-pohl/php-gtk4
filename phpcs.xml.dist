<?xml version="1.0"?>
<ruleset name="php-gtk4">
    <description>PSR-12 for the PHP side (tests, examples, stubs, gen). phpcbf fixes what it can.</description>

    <file>tests</file>
    <file>examples</file>
    <file>stubs</file>
    <file>gen</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>stubs/gtk4.php</exclude-pattern>
    <exclude-pattern>gen/gen_stub.php</exclude-pattern>
    <exclude-pattern>gen/PHP-Parser-*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <!-- parallel=N is passed on the command line by ci.sh -->
    <arg name="cache" value=".phpcs.cache"/>

    <config name="php_version" value="80400"/>

    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- Decision (docs/PLAN.md): the API is snake_case like the GTK C API, final.
         stubs/gtk4.php mirrors it: snake_case methods, all classes in one file,
         one-line dummy bodies. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.WhiteSpace.ScopeClosingBrace">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Functions.MultiLineFunctionDeclaration">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
    <!-- php-cs-fixer puts declare() before the file docblock; PSR12's sniff wants the
         opposite. The fixer wins (it rewrites), so drop this sniff for the stub. -->
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>stubs/*</exclude-pattern>
    </rule>
</ruleset>
