<?xml version="1.0"?>
<ruleset name="php-gtk4">
    <description>PSR-12 for the PHP side (tests, examples, gen). phpcbf fixes what it can.</description>

    <file>tests</file>
    <file>examples</file>
    <file>gen</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/phpt/*</exclude-pattern>
    <exclude-pattern>gen/gen_stub.php</exclude-pattern>
    <exclude-pattern>gen/PHP-Parser-*</exclude-pattern>
    <exclude-pattern>gen/out/*</exclude-pattern>
    <exclude-pattern>tests/Generated/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <!-- parallel=N is passed on the command line by ci.sh -->
    <arg name="cache" value=".phpcs.cache"/>

    <config name="php_version" value="80400"/>

    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- gen/gir.php: the generator's data model (Type, Param, Func, Node) and the generator are
         one program; splitting them into files would only spread one script over six. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>gen/gir.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>gen/gir.php</exclude-pattern>
    </rule>
    <!-- PER-CS 2.0 (php-cs-fixer, which rewrites) allows `) {}` on a promoted-property
         constructor; these PSR-12 sniffs predate that. The fixer wins, as for the stub. -->
    <rule ref="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine">
        <exclude-pattern>gen/gir.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore">
        <exclude-pattern>gen/gir.php</exclude-pattern>
    </rule>

    <!-- PHP subclasses override GTK virtual methods as vfunc_<name>() (src/core/subtype,
         docs/PLAN.md §2.6): the name mirrors the class-struct slot, snake_case like the whole API. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>

    <!-- Not linted: src/gtk4.stub.php (php-src stub syntax) and the generated stubs/gtk4.php
         (snake_case API, all classes in one file, dummy bodies - see docs/PLAN.md). -->
</ruleset>
