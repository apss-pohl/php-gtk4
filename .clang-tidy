Checks: >-
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-*,
  -modernize-use-trailing-return-type,
  -modernize-use-auto,
  -modernize-use-default-member-init,
  -modernize-loop-convert,
  -modernize-use-equals-default,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-slicing,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -performance-noexcept-swap,
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const,
  -readability-implicit-bool-conversion,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-named-parameter,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -bugprone-casting-through-void,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  -readability-else-after-return,
  -modernize-use-integer-sign-comparison,
  -modernize-type-traits,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers

# Rationale for the deny-list: GLib macros expand to do/while, varargs,
# C-style casts through void* (G_OBJECT(), GTK_WINDOW(), ...) and pointer
# arithmetic; Zend macros (ZEND_PARSE_PARAMETERS_*, Z_*_P, RETURN_*) expand to
# zval union access, multi-declarations, array decay, signed/unsigned compares
# and huge cognitive complexity; PHP_INI_BEGIN/zend_function_entry tables are C
# arrays by API contract; G_OBJECT_GET_CLASS() expands to type-trait-like casts.
# Everything else is enforced - CI fails on findings.
# Every enabled check is an error, locally (ci.sh) and in CI (cpp-linter) alike.
WarningsAsErrors: '*'
HeaderFilterRegex: '^(src/|main\.h)'
FormatStyle: file
