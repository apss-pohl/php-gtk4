Checks: >-
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-*,
  -modernize-use-trailing-return-type,
  -modernize-use-auto,
  -modernize-use-default-member-init,
  -modernize-loop-convert,
  -modernize-use-equals-default,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-slicing,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -performance-noexcept-swap,
  -performance-enum-size,  # uint8_t bases for a two-case enum buy nothing and hurt readability
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const,
  -readability-implicit-bool-conversion,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-named-parameter,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -bugprone-casting-through-void,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  -readability-else-after-return,
  -modernize-use-integer-sign-comparison,
  -modernize-type-traits,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers

# Rationale for the deny-list: GLib macros expand to do/while, varargs,
# C-style casts through void* (G_OBJECT(), GTK_WINDOW(), ...) and pointer
# arithmetic; Zend macros (ZEND_PARSE_PARAMETERS_*, Z_*_P, RETURN_*) expand to
# zval union access, multi-declarations, array decay, signed/unsigned compares
# and huge cognitive complexity; PHP_INI_BEGIN/zend_function_entry tables are C
# arrays by API contract; G_OBJECT_GET_CLASS() expands to type-trait-like casts.
# The rest of the deny-list is house style, decided rather than forced by a macro:
#  - use-trailing-return-type, use-auto, type-traits, use-integer-sign-comparison: C++20
#    written in the C idiom the GLib/Zend APIs are, explicit types where a GObject cast is
#    involved; std::cmp_* would litter every Zend macro comparison.
#  - use-default-member-init, use-equals-default, loop-convert, init-variables: handle structs
#    are initialised by create_object(), out-parameters by ZPP; the C-style loops walk GLib lists.
#  - braces-around-statements, else-after-return, isolate-declaration, named-parameter,
#    identifier-length: one-line guards (`if (x == nullptr) RETURN_THROWS();`) are the pattern of
#    every method; clang-format keeps them readable.
#  - implicit-bool-conversion: gboolean is an int by API contract.
#  - convert-member-functions-to-static, make-member-function-const, noexcept-swap: Zend handler
#    and GLib callback signatures are fixed.
#  - easily-swappable-parameters: (x, y), (width, height), (min, max) pairs are GTK's own.
#  - casting-through-void, avoid-non-const-global-variables: gpointer user data and the module
#    globals (GTK4_G) are the GLib and Zend idioms.
#  - avoid-c-arrays, magic-numbers: zend_function_entry / PHP_INI tables and GType ids.
# Everything else is enforced - CI fails on findings.
# Every enabled check is an error, locally (ci.sh) and in CI (cpp-linter) alike.
WarningsAsErrors: '*'
# Naming (readability-identifier-naming): snake_case functions/variables/namespaces,
# CamelCase types and enum cases, UPPER_CASE macros. Zend/GLib-generated names
# (zim_*, *_get_type, _PhpValue) come from macro expansions and are not checked.
CheckOptions:
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  # register_vfuncs_<GTypeName>: generated per class, named like gen_stub's register_class_Gtk4_X
  readability-identifier-naming.FunctionIgnoredRegexp: '^register_vfuncs_[A-Z]'
  readability-identifier-naming.GlobalFunctionIgnoredRegexp: '^register_vfuncs_[A-Z]'
  readability-identifier-naming.VariableCase: lower_case
  # ce_<GTypeName>: class entries named after the GType they wrap (MINIT, registries).
  readability-identifier-naming.VariableIgnoredRegexp: '^ce_[A-Z]'
  readability-identifier-naming.LocalPointerIgnoredRegexp: '^ce_[A-Z]'
  readability-identifier-naming.GlobalPointerIgnoredRegexp: '^ce_[A-Z]'
  readability-identifier-naming.StaticVariableIgnoredRegexp: '^ce_[A-Z]'
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.TypeAliasCase: CamelCase
# ci.sh passes --header-filter (and --exclude-header-filter for the gen_stub *_arginfo.h)
# explicitly: this key alone left src/**/*.h unlinted for TUs given with absolute -I paths.
HeaderFilterRegex: '(^|/)src/'
FormatStyle: file
